# Copy to .env in the project root (git-ignored already) and fill in.
SMTP_HOST=
SMTP_PORT=587
# 'true' only for port 465 (implicit TLS); leave unset/false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional overrides.
# MAIL_FROM=hello@revisithistory.be
# MAIL_TO=hello@revisithistory.be
# PORT=8787
